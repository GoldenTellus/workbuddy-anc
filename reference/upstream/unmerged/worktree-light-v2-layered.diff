+await tool("vault_write", {
+  path: REPORT,
+  content: "# 报告\n\n## 一、情况\n乙改写\n\n## 二、发现\n乙补充:需核实\n",
+  base_etag: etag,
+  author: "乙",
+  reason: "补发现",

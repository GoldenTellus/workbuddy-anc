+const resolved = await anc("push", REPORT_ABS, "--resolved", "--author", "甲", "--reason", "合并后提交");
+ok("★ 合并后 --resolved 能提交成功(不再死锁)", resolved.code === 0 && /已写入/.test(resolved.out), resolved.out);
+

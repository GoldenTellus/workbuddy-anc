  "workbuddyVersion": "5.9.3",
  "electron": "37.10.3",
  "target": "main/wecomaibot-client.js",
  "sha256": "3510b3098686021a01827680b0d84a33daa9ef168b522fe8276ee72b8fae6fe5",
  "size": 27427,
  "prefix": "[anc:chat=",
  "bootstrapTarget": "main/main-bootstrap.js",
